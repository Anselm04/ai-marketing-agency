{
  "version": 2,
  "buildCommand": "npm run build --workspace=frontend",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://trillionai-marketing.fly.dev/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
