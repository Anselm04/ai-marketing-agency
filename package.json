{
  "name": "ai-marketing-agency",
  "version": "0.1.0",
  "description": "World-Leading AI-Powered Marketing Agency App",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "bullmq": "^6.0.11",
    "caniuse-lite": "^1.0.30001809",
    "compression": "^1.8.1",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "stripe": "^22.5.0",
    "winston": "^3.19.0"
  }
}
