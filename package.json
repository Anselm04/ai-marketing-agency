{
  "name": "ai-marketing-agency",
  "version": "0.1.0",
  "description": "World-Leading AI-Powered Marketing Agency App",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "lint": "npm run lint --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "caniuse-lite": "^1.0.30001809",
    "compression": "^1.8.2",
    "qs": "6.16.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "postcss-selector-parser": "7.1.7"
  }
}
