# Required
JWT_SECRET=change-me-to-a-long-random-string-in-production-min-32-chars
NODE_ENV=development
PORT=3001

# Database
USE_MONGO=false
MONGODB_URI=mongodb://localhost:27017/ai_marketing

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aimarketing.com

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-marketing-uploads

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security
ENCRYPTION_KEY=

# Features
WEBSOCKET_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
