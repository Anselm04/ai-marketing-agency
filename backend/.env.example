# TrillionAI Marketing environment configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string-in-production-min-32-chars

# PostgreSQL / Supabase persistence
# Production startup is blocked unless one of these is set.
DATABASE_URL=
SUPABASE_DB_URL=
DB_POOL_MAX=10

# AppForge <-> Marketing ecosystem bridge
# Must exactly match the AppForge deployment secret.
TRILLION_ECOSYSTEM_SHARED_SECRET=replace-with-long-random-shared-secret
APPFORGE_URL=https://your-appforge.example.com
PUBLIC_SITE_URL=https://trillionaitech.com

# AI Providers
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Public origins. OAuth redirect URIs are ${API_URL}/api/social/oauth/<platform>/callback.
# Production: set all three to https://trillionai-marketing.fly.dev
API_URL=http://localhost:3001
PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Per-user social account OAuth and video publishing
# X (user OAuth 2.0). A bearer token is not enough to post as the connected user.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# TikTok Login Kit. PKCE is required. Keep SELF_ONLY until the app is audited for public Direct Post.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Meta (Facebook Page + Instagram professional). Same app for both.
# Set META_GRAPH_VERSION to the version enabled on the Meta app. v18 is retired.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Optional when the login can see more than one Page / Instagram account.
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
# YouTube / Google. Keep private until the Google project has passed any required audit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=private
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202609
SOCIAL_VIDEO_MAX_BYTES=268435456

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trillionaitech.com

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=ai-marketing-uploads
# Separate private bucket for user source photos/videos. Strongly recommended in production.
S3_PRIVATE_BUCKET=ai-marketing-private
# Backward-compatible alias supported: S3_BUCKET_NAME=
S3_ENDPOINT=
# Optional public base URL for public generated assets. Raw Course Factory source footage stays private.
S3_PUBLIC_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend / CORS
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security. Production token encryption requires ENCRYPTION_KEY or JWT_SECRET of at least 32 characters.
ENCRYPTION_KEY=
AUDIT_HASH_SALT=

# User media library
MEDIA_UPLOAD_MAX_BYTES=262144000
MEDIA_UPLOAD_MAX_FILES=20
MEDIA_COMPOSE_MAX_ASSETS=20
MEDIA_COMPOSE_MAX_SOURCE_BYTES=314572800
MEDIA_COMPOSE_TIMEOUT_MS=900000
SOCIAL_VIDEO_MAX_BYTES=268435456

# Automated social posting
AUTO_POSTING_SCHEDULER_ENABLED=true
AUTO_POSTING_CRON=*/5 * * * *

# AI clipping pipeline
# Course Factory currently reuses the same transcription primitive, so set this high enough for your longest single course source.
CLIPPING_MAX_SOURCE_SECONDS=43200
CLIPPING_TRANSCRIPTION_CHUNK_SECONDS=900
CLIPPING_PROCESS_TIMEOUT_MS=900000
# Comma-separated trusted direct-media hosts for externally hosted media.
# Wildcards are limited to a leading *., for example: *.example-cdn.com
CLIPPING_SOURCE_HOST_ALLOWLIST=
CLIPPING_AUTOMATION_SCHEDULER_ENABLED=true
CLIPPING_AUTOMATION_CRON=*/5 * * * *

# Course Factory: long-form video -> professional course package
# 500 GiB maximum source object; uploads go browser -> private object storage using multipart upload.
COURSE_FACTORY_MAX_SOURCE_BYTES=536870912000
COURSE_FACTORY_MULTIPART_PART_BYTES=67108864
# Short-lived private source links are generated only for backend processing.
COURSE_FACTORY_SOURCE_SIGNED_URL_SECONDS=21600
# Visual analysis is deliberately sampled/bounded rather than sending every frame to an AI model.
COURSE_FACTORY_VISION_MODEL=gpt-4o-mini
COURSE_FACTORY_VISUAL_INTERVAL_SECONDS=120
COURSE_FACTORY_VISUAL_MAX_FRAMES=36
COURSE_FACTORY_VISUAL_BATCH_SIZE=4
COURSE_FACTORY_VISUAL_PROCESS_TIMEOUT_MS=120000
# Approved lesson video rendering.
COURSE_FACTORY_RENDER_TIMEOUT_MS=3600000
COURSE_FACTORY_MAX_LESSON_SECONDS=5400

# Queue / long-running work
REDIS_URL=redis://localhost:6379
USE_REDIS_QUEUE=true
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# Features
WEBSOCKET_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Never commit real production secrets. Configure them in the deployment platform.
