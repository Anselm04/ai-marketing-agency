# TrillionAI Marketing environment configuration
# Never commit production secrets.

# Required
JWT_SECRET=change-me-to-a-long-random-string-in-production-min-32-chars
NODE_ENV=development
PORT=3001

# Production persistence (Supabase/PostgreSQL required when NODE_ENV=production)
DATABASE_URL=
# Or use SUPABASE_DB_URL instead of DATABASE_URL.
SUPABASE_DB_URL=

# Development-only legacy/local persistence options
USE_MONGO=false
MONGODB_URI=mongodb://localhost:27017/ai_marketing

# Holy Trinity ecosystem
APPFORGE_URL=https://appforge-unfurling-moon-9058.fly.dev
TRILLION_PUBLIC_SITE_URL=https://trillionaitech.com
# Generate a unique 32+ byte value and set the SAME secret in AppForge.
TRILLION_ECOSYSTEM_SHARED_SECRET=replace-with-a-long-random-shared-secret

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trillionaitech.com

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=trillionai-marketing-uploads

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend / production URLs
APP_URL=https://trillionai-marketing.fly.dev
API_URL=https://trillionai-marketing.fly.dev
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://trillionaitech.com

# Security
ENCRYPTION_KEY=

# Redis / background work
REDIS_URL=

# Features
WEBSOCKET_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Production rules
# - Production startup is blocked unless PostgreSQL/Supabase persistence is available.
# - The AppForge intake endpoint accepts only fresh HMAC-signed ecosystem requests.
# - AppForge and this service must share TRILLION_ECOSYSTEM_SHARED_SECRET.
# - A matching Marketing account email is required before an AppForge project can create a campaign.
# - Keep live Stripe credentials in Fly/provider secret storage, not in this file.
