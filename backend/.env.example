# Backend
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key
MASTER_CODE=your_admin_master_code

# Persistence — production should set one of these:
# DATA_DIR=/data          # Fly volume mount (JSON files survive restarts)
# DATABASE_URL=postgres://...  # preferred once Postgres adapter is enabled
DATA_DIR=

# Frontend / CORS
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# OpenAI (required for real AI generation; otherwise endpoints fail honestly / use templates)
OPENAI_API_KEY=

# Optional alternate providers (not required by current openaiService)
GROQ_API_KEY=
GEMINI_API_KEY=

# Live Stripe for TrillionAI Marketing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ecosystem bridge (AppForge signed handoffs)
TRILLION_ECOSYSTEM_SHARED_SECRET=
APPFORGE_URL=https://appforge-unfurling-moon-9058.fly.dev
TRILLION_PUBLIC_SITE_URL=https://trillionaitech.com
API_URL=http://localhost:3001

# Per-platform connector tokens (organic publish is honest-fail without these)
TIKTOK_ACCESS_TOKEN=
META_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_ACCESS_TOKEN=
