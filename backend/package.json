{
  "name": "ai-marketing-agency-backend",
  "version": "1.0.0",
  "description": "AI Marketing Agency API",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
