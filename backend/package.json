{
  "name": "ai-marketing-agency-backend",
  "version": "1.0.0",
  "description": "AI Marketing Agency API with Supabase PostgreSQL production persistence",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test JWT_SECRET=test-secret NODE_OPTIONS=--experimental-vm-modules npx jest --coverage --passWithNoTests",
    "test:watch": "NODE_ENV=test JWT_SECRET=test-secret NODE_OPTIONS=--experimental-vm-modules npx jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.9",
    "openai": "^7.15.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.5",
    "stripe": "^22.6.2",
    "winston": "^3.13.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
