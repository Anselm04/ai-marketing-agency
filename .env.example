# Backend
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ai_marketing_agency
JWT_SECRET=your_jwt_secret_key
MASTER_CODE=your_admin_master_code

# Frontend
APP_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=sk-your_openai_key

# Social Media APIs
TIKTOK_ACCESS_TOKEN=your_tiktok_token
META_ACCESS_TOKEN=your_meta_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
YOUTUBE_API_KEY=your_youtube_key
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_token
GOOGLE_SEARCH_CONSOLE_KEY=your_gsc_key

# Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# eCommerce
SHOPIFY_API_KEY=your_shopify_key
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# App Store / Google Play
APP_STORE_CONNECT_API_KEY=your_app_store_key
GOOGLE_PLAY_SERVICE_ACCOUNT=your_google_play_json

# Other Integrations
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
GUMROAD_API_KEY=your_gumroad_key
